{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yubin-hiki",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "yubin-hiki.yhay81.com",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["19 20 * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yubin-hiki",
      "database_id": "f7661144-afc3-47c0-bbad-95e2a0ec0c6d",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
}
